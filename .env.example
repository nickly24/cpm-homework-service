ENV=development
PORT=8001
JWT_SECRET_KEY=replace-with-the-same-value-as-cpm-back

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=cpm
MYSQL_PASSWORD=replace-me
MYSQL_DATABASE=cpm
MYSQL_POOL_SIZE=8

S3_ENDPOINT_URL=https://s3.twcstorage.ru
S3_REGION=ru-1
S3_BUCKET=replace-me
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_PRESIGN_TTL_SECONDS=300

CORS_ORIGINS_EXTRA=
RUN_HOMEWORK_WORKER=true
PDF_MAX_BYTES=10485760
PDF_MAX_PAGES=35
JOB_STALE_SECONDS=180
JOB_POLL_SECONDS=2
